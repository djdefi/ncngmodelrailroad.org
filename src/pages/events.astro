---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import { formatEventDate, isUpcomingEvent } from '../utils/events';
import { organization } from '../config/organization';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const events = await getCollection('events');
const sortedEvents = events.sort((a, b) => 
  new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);
const now = new Date();
const upcomingEvents = sortedEvents.filter(e => isUpcomingEvent(e.data, now));
const pastEvents = sortedEvents.filter(e => !isUpcomingEvent(e.data, now)).reverse();

const siteUrl = Astro.site?.origin || 'https://ncngmodelrailroad.org';

const eventSchemaItems = upcomingEvents.map((event) => {
  const item: Record<string, unknown> = {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": event.data.title,
    "description": event.data.description || event.data.title,
    "startDate": event.data.date.toISOString().split('T')[0],
    "endDate": (event.data.endDate || event.data.date).toISOString().split('T')[0],
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": event.data.location,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grass Valley",
        "addressRegion": "CA",
        "addressCountry": "US",
      },
    },
    "organizer": {
      "@type": "Organization",
      "name": "N.C.N.G. Historical Model Railroad",
      "url": siteUrl,
    },
  };
  return item;
});

// Escape characters that could break out of the <script> context (for example
// a literal </script> inside an event title). JSON consumers read these escapes
// back to the original characters, so the structured data is unchanged.
const eventSchemaJson = JSON.stringify(eventSchemaItems)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');

---

<BaseLayout title="Plan Your Visit & Events | N.C.N.G. Model Railroad" description="Public visits are available only during published events. Find event dates and layout visiting hours for the N.C.N.G. Historical Model Railroad." image="/images/building-exterior.jpg">
  {eventSchemaItems.length > 0 && (
    <script type="application/ld+json" set:html={eventSchemaJson} />
  )}
  <!-- Hero -->
  <section class="bg-gray-900 text-white py-12 md:py-16">
    <div class="page-container text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Plan Your Visit</h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        {organization.visiting.publicAccess}
      </p>
    </div>
  </section>

  <section class="py-10 md:py-12 bg-white">
    <div class="page-container max-w-4xl">
      <div class="mb-8 max-w-prose">
        <p class="text-gray-700 mb-3">{organization.visiting.eventTiming}</p>
        <p class="text-gray-600 mb-4">
          Read each listing for layout hours. Times not yet listed are TBA.
          Host events may charge admission or parking to reach the layout.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <a href={organization.location.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-primary underline font-semibold">Get Directions</a>
          <a href={`${base}/contact`} class="text-primary underline font-semibold">Ask About a Published Event</a>
        </div>
      </div>
      <h2 class="text-3xl font-bold mb-6">Upcoming Public Events</h2>
      
      {upcomingEvents.length > 0 ? (
        <div class="space-y-8">
          {upcomingEvents.map(async (event) => {
            const { Content } = await render(event);
            return (
              <article id={`event-${event.id}`} class="clean-card p-6 scroll-mt-24">
                <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                  <div>
                    <h2 class="text-2xl font-display text-gray-900">{event.data.title}</h2>
                    <p class="text-primary font-medium mt-1">
                      Event dates: {formatEventDate(event.data.date, event.data.endDate)}
                    </p>
                  </div>
                  {event.data.featured && (
                    <span class="bg-gold text-gray-900 px-3 py-1 rounded-full text-sm font-medium">
                      Featured
                    </span>
                  )}
                </div>
                <p class="text-gray-600 mb-2">
                  <Icon name="solar:map-point-bold" class="w-4 h-4 inline-block mr-1" />
                  {event.data.location}
                </p>
                <div class="prose prose-sm mt-4 max-w-prose">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="text-gray-600">No upcoming public events are published. Please wait for a listed event before planning your visit.</p>
      )}
    </div>
  </section>

  {pastEvents.length > 0 && (
    <section class="py-16 bg-cream">
      <div class="page-container max-w-4xl">
        <details>
          <summary class="text-2xl font-display text-primary cursor-pointer">Past Events ({pastEvents.length})</summary>
          <p class="text-gray-600 my-6">These dates have passed. Past listings do not establish future opening dates, hours, or admission arrangements.</p>
          <div class="space-y-6">
            {pastEvents.map(async (event) => {
              const { Content } = await render(event);
              return (
                <article id={`event-${event.id}`} class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 scroll-mt-24">
                  <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                    <div>
                      <h2 class="text-xl font-display text-gray-800">{event.data.title}</h2>
                      <p class="text-sm text-gray-500 mt-1">{formatEventDate(event.data.date, event.data.endDate)}</p>
                    </div>
                    <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-xs font-medium">Past event</span>
                  </div>
                  <p class="text-gray-500 text-sm mb-2">
                    <Icon name="solar:map-point-bold" class="w-4 h-4 inline-block mr-1" />
                    {event.data.location}
                  </p>
                  <div class="prose prose-sm mt-3">
                    <Content />
                  </div>
                </article>
              );
            })}
          </div>
        </details>
      </div>
    </section>
  )}

  <section class="py-16 bg-primary text-white text-center">
    <div class="page-container">
      <h2 class="text-3xl font-display mb-4">Want to Get Involved?</h2>
      <p class="text-xl mb-8 text-gray-200">We&apos;re always looking for volunteers to help with events, work sessions, and operations.</p>
      <Button href={`${base}/volunteer`} variant="white">Become a Volunteer</Button>
      <p class="mt-6 text-sm text-gray-200">
        Know about an event we should list, or see something out of date?
        <a href="https://github.com/djdefi/ncngmodelrailroad.org/issues/new?template=event.yml" class="underline hover:text-white">Submit or correct an event &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>
