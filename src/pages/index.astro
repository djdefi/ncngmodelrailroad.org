---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { organization } from '../config/organization';
import { getCollection } from 'astro:content';
import { formatEventDate, isUpcomingEvent } from '../utils/events';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const now = new Date();
const nextEvent = (await getCollection('events'))
  .filter(event => isUpcomingEvent(event.data, now))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0];
---

<BaseLayout title="Nevada County Narrow Gauge Historical Model Railroad" description="A historical model railroad at the Nevada County Fairgrounds, preserving the Nevada County Narrow Gauge Railroad (1876 to 1942). Public visits only during published events." image="/images/engine8-hero.jpg" heroImage={`${base}/images/engine8-hero.jpg`}>
  <!-- Hero Section - Full-bleed with Engine #8 -->
  <section class="relative min-h-[90vh] flex items-end text-white overflow-hidden" aria-labelledby="hero-title">
    <div class="absolute inset-0 z-0">
      <img 
        src={`${base}/images/engine8-hero.jpg`} 
        alt="Engine #8 approaching on the model railroad tracks with switches and scenery" 
        class="w-full h-full object-cover animate-kenburns"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width={1200}
        height={675}
      />
      <div class="absolute inset-0 hero-vignette"></div>
    </div>
    <div class="page-container relative z-10 pb-16 md:pb-24 pt-40">
      <div class="max-w-3xl">
        <span class="hero-kicker inline-block text-xs uppercase font-semibold mb-4 border px-4 py-2 rounded-full">Est. 1986 · Nevada County Fairgrounds · Grass Valley, CA</span>
        <h1 id="hero-title" class="text-4xl md:text-6xl lg:text-7xl font-bold mb-4 text-white leading-[1.1]" style="font-family: 'Archivo Black', serif;">
          Nevada County<br />Narrow Gauge
        </h1>
        <p class="hero-label text-sm uppercase font-medium mb-6">Historical Model Railroad</p>
        <p class="hero-copy text-lg md:text-xl mb-10 leading-relaxed max-w-xl">
          Watch miniature trains travel through local towns and landscapes,
          recreating the railroad that served Nevada County from {organization.prototype.serviceStart} to {organization.prototype.serviceEnd}.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href={`${base}/events`} size="lg">Plan Your Visit</Button>
          <Button href={`${base}/map/`} variant="outline-inverse" size="lg">
            Explore the Railroad Map
          </Button>
          <Button href={`${base}/about`} variant="outline-inverse" size="lg">
            About the Layout
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-cream border-b border-gray-200" aria-labelledby="visit-title">
    <div class="page-container grid md:grid-cols-2 gap-8 md:gap-12">
      <div>
        <h2 id="visit-title" class="text-3xl font-bold mb-4">When You Can Visit</h2>
        <p class="text-lg text-gray-900 font-semibold mb-3">{organization.visiting.publicAccess}</p>
        <p class="text-gray-600 mb-5">{organization.visiting.eventTiming}</p>
        <a href={organization.location.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-primary underline font-semibold">
          Get Directions to the Fairgrounds
        </a>
      </div>
      <div>
        {nextEvent ? (
          <>
            <h3 class="text-xl font-bold mb-3">Next Published Event: {nextEvent.data.title}</h3>
            <p class="text-gray-700 mb-3">Event dates: {formatEventDate(nextEvent.data.date, nextEvent.data.endDate)}</p>
            <p class="text-gray-600 mb-5">Read the event details for layout hours. If no times are listed, hours are still to be announced.</p>
            <Button href={`${base}/events#event-${nextEvent.id}`}>View Event Details</Button>
          </>
        ) : (
          <>
            <h3 class="text-xl font-bold mb-3">No Upcoming Public Events Published</h3>
            <p class="text-gray-600 mb-5">Please wait for a published event before planning a public visit.</p>
            <Button href={`${base}/events`}>View Events</Button>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="page-container">
      <div class="grid lg:grid-cols-5 gap-8 md:gap-12 items-center">
        <div class="lg:col-span-3">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 leading-tight">
            Local History in Miniature
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            Volunteers have built and maintained the layout since {organization.founded}.
            Follow trains through miniature Nevada City, Grass Valley, Chicago Park,
            and Colfax, including the Bear River Bridge.
          </p>
          <p class="text-gray-600 mb-6 leading-relaxed">
            On-board cameras bring a train-level view of the towns, yards, and bridges
            to our Train Cam TV display.
          </p>
          <div class="flex flex-wrap gap-6">
            <a href={`${base}/gallery`} class="text-primary underline font-semibold">See Layout Photos</a>
            <a href={`${base}/about`} class="text-primary underline font-semibold">How the Layout Works</a>
          </div>
        </div>
        <div class="lg:col-span-2">
          <figure>
            <img 
              src={`${base}/images/gallery-img_9139.jpg`}
              alt="Miniature freight cars beside a trackside building and wooded hills"
              class="rounded-xl w-full"
              loading="lazy"
              decoding="async"
              width={800}
              height={600}
            />
            <figcaption class="text-sm text-gray-600 mt-3">Trackside scenery on our model railroad.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit CTA - Full width with building exterior photo -->
  <section class="relative py-28 md:py-36 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src={`${base}/images/building-exterior.jpg`} 
        alt="N.C.N.G. Historical Model Railroad building at the Nevada County Fairgrounds with Railroad Crossing sign and Historical Exhibit Open sandwich board" 
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        width={1200}
        height={675}
      />
      <div class="absolute inset-0 bg-gray-900/60"></div>
    </div>
    <div class="page-container relative z-10">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Visit the Layout</h2>
        <p class="text-xl text-gray-200 mb-4">
          {organization.visiting.publicAccess}
        </p>
        <address class="text-gray-300 not-italic mb-8 flex items-start gap-3">
          <Icon name="solar:map-point-bold" class="w-6 h-6 text-amber-400 flex-shrink-0 mt-0.5" />
          <span>
            {organization.location.venue}<br />
            {organization.location.streetAddress}<br />
            {organization.location.city}, {organization.location.state}
          </span>
        </address>
        <div class="flex flex-wrap gap-4">
          <Button href={`${base}/events`} size="lg">Plan Your Visit</Button>
          <Button href={organization.location.mapsUrl} external variant="outline-inverse" size="lg">
            Get Directions
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Section - Asymmetric, warm appeal -->
  <section class="py-20 bg-white">
    <div class="page-container">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-5 gap-8">
          <!-- Donate - Takes more space, more prominent -->
          <div class="md:col-span-3 bg-primary text-white rounded-2xl p-8 md:p-10 relative overflow-hidden shadow-2xl">
            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-4">
                <Icon name="solar:heart-bold" class="w-8 h-8 text-amber-300" />
              </div>
              <h2 class="text-2xl md:text-3xl font-bold mb-4">Help Maintain the Layout</h2>
              <p class="text-gray-200 mb-6 leading-relaxed">
                Donations help cover upkeep, repairs, scenery work, rolling stock, wiring,
                and improvements to the building and display.
              </p>
              <Button href={`${base}/donate`} variant="white">
                Support the Layout
              </Button>
            </div>
            <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-white/5 rounded-full"></div>
            <div class="absolute -top-4 -right-12 w-24 h-24 bg-white/5 rounded-full"></div>
          </div>

          <!-- Volunteer - Smaller, complementary -->
          <div class="md:col-span-2 clean-card p-8 md:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <Icon name="solar:users-group-rounded-bold" class="w-7 h-7 text-primary" />
              </div>
              <h2 class="text-xl md:text-2xl font-bold mb-4 text-gray-900">Become a Volunteer</h2>
              <p class="text-gray-600 mb-6 text-sm leading-relaxed">
                If you like trains, local history, scenery, wiring, carpentry, or talking with visitors, there&apos;s useful work to do.
              </p>
            </div>
            <Button href={`${base}/volunteer`}>
              Volunteer With Us
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Note Section -->
  <section class="py-6 bg-gray-100 border-t border-gray-200">
    <div class="page-container">
      <p class="text-center text-sm text-gray-600">
        <strong>Note:</strong> The N.C.N.G. Historical Model Railroad is a separate 
        organization not affiliated with other museums or groups.
      </p>
    </div>
  </section>
</BaseLayout>
